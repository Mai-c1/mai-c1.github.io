{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Getting Started","text":""},{"location":"#mai-wiki","title":"\u6b22\u8fce\u6765\u5230 Mai Wiki","text":"<p>\u6211\u59d3 Mai\uff0c\u5728\u6559\u5b66\u7684\u8fc7\u7a0b\u4e2d\uff0c\u6211\u53d1\u73b0\u540c\u5b66\u4eec\u7684\u7b14\u8bb0\u4e60\u60ef\u5e76\u4e0d\u662f\u5f88\u597d\uff0c\u672c\u7f51\u7ad9\u5c06\u4e00\u4e9b\u5e38\u89c1\u7684\u77e5\u8bc6\u70b9\u8fdb\u884c\u603b\u7ed3\u5f52\u7eb3\uff0c\u5c3d\u91cf\u4ee5\u901a\u4fd7\u6613\u61c2\u7684\u65b9\u5f0f\u5448\u73b0\u7ed9\u540c\u5b66\u4eec</p>"},{"location":"%E5%9F%BA%E7%A1%80%E7%AE%97%E6%B3%951/","title":"\u7b97\u6cd51\u7b80\u4ecb","text":"<p>\u5728\u6b64\u9636\u6bb5\uff0c\u4f60\u4f1a\u6162\u6162\u5b66\u4e60\u4e00\u4e9b\u7ecf\u5178\u7b97\u6cd5\uff0c\u6bd4\u5982</p> <p>\u6392\u5e8f\u7b97\u6cd5</p> <ul> <li>\u5192\u6ce1\u6392\u5e8f</li> <li>\u9009\u62e9\u6392\u5e8f</li> <li>\u63d2\u5165\u6392\u5e8f</li> <li>\u6876\u6392\u5e8f</li> </ul> <p>\u679a\u4e3e\u7b97\u6cd5</p> <p>\u6a21\u62df\u7b97\u6cd5</p> <p>\u9ad8\u7cbe\u5ea6\u7b97\u6cd5</p> <p>\u8fd8\u6709\u4e00\u4e9b\u6bd4\u8f83\u5b9e\u7528\u7684\u6280\u5de7\uff0c\u6bd4\u5982sort\u51fd\u6570\u3001\u7ed3\u6784\u4f53\u4ee5\u53ca\u7ed3\u6784\u4f53\u6392\u5e8f</p>"},{"location":"%E5%9F%BA%E7%A1%80%E7%AE%97%E6%B3%951/%E6%8E%92%E5%BA%8F%E7%AE%80%E4%BB%8B/","title":"\u6392\u5e8f\u7b80\u4ecb","text":""},{"location":"%E5%9F%BA%E7%A1%80%E7%AE%97%E6%B3%951/%E6%8E%92%E5%BA%8F%E7%AE%80%E4%BB%8B/#_1","title":"\u5b9a\u4e49","text":"<p>\u6392\u5e8f\u7b97\u6cd5\u662f\u4e00\u79cd\u5c06\u4e00\u7ec4\u7279\u5b9a\u7684\u6570\u636e\u6309\u67d0\u79cd\u89c4\u5219\u8fdb\u884c\u6392\u5217\u7684\u7b97\u6cd5</p> <ul> <li>\u8fd9\u4e2a\u89c4\u5219\u53ef\u4ee5\u5f88\u7b80\u5355\uff0c\u6bd4\u5982\u6309\u8003\u8bd5\u603b\u5206\u4ece\u9ad8\u5230\u4f4e\u6392\u5e8f</li> <li>\u4e5f\u4f1a\u5f88\u590d\u6742\uff0c\u6bd4\u5982\u5148\u6309\u603b\u5206\u6392\u5e8f\uff0c\u603b\u5206\u76f8\u540c\u6309\u8bed\u6587\u6210\u7ee9\u6392\uff0c\u8bed\u6587\u6210\u7ee9\u76f8\u540c\u518d......</li> </ul>"},{"location":"%E5%9F%BA%E7%A1%80%E7%AE%97%E6%B3%951/%E6%8E%92%E5%BA%8F%E7%AE%80%E4%BB%8B/#_2","title":"\u6027\u8d28","text":""},{"location":"%E5%9F%BA%E7%A1%80%E7%AE%97%E6%B3%951/%E6%8E%92%E5%BA%8F%E7%AE%80%E4%BB%8B/#_3","title":"\u7a33\u5b9a\u6027","text":"<p>\u7a33\u5b9a\u6027\u662f\u6307\u76f8\u7b49\u7684\u5143\u7d20\u7ecf\u8fc7\u6392\u5e8f\u4e4b\u540e\u76f8\u5bf9\u987a\u5e8f\u662f\u5426\u53d1\u751f\u4e86\u6539\u53d8\u3002</p>"},{"location":"%E5%9F%BA%E7%A1%80%E7%AE%97%E6%B3%951/%E6%8E%92%E5%BA%8F%E7%AE%80%E4%BB%8B/#_4","title":"\u65f6\u95f4\u590d\u6742\u5ea6","text":""},{"location":"%E5%9F%BA%E7%A1%80%E7%AE%97%E6%B3%951/%E6%8E%92%E5%BA%8F%E7%AE%80%E4%BB%8B/#_5","title":"\u7a7a\u95f4\u590d\u6742\u5ea6","text":""},{"location":"%E5%9F%BA%E7%A1%80%E7%AE%97%E6%B3%951/%E6%A0%BC%E5%BC%8F%E5%8C%96%E8%BE%93%E5%85%A5%E8%BE%93%E5%87%BA/","title":"\u683c\u5f0f\u5316\u8f93\u5165\u8f93\u51fa","text":""},{"location":"%E5%9F%BA%E7%A1%80%E7%AE%97%E6%B3%951/%E6%A0%BC%E5%BC%8F%E5%8C%96%E8%BE%93%E5%85%A5%E8%BE%93%E5%87%BA/#_2","title":"\u57fa\u672c\u7528\u6cd5","text":"<pre><code>#include &lt;bits/stdc++.h&gt;\nusing namespace std;\n\nint main() {\n    int x, y;\n    scanf(\"%d%d\", &amp;x, &amp;y);   // \u8bfb\u5165 x \u548c y\n    printf(\"%d\\n%d\", y, x);  // \u8f93\u51fa y\uff0c\u6362\u884c\uff0c\u518d\u8f93\u51fa x\n\n    printf(\"hello,world\");// printf\u4e5f\u53ef\u4ee5\u76f4\u63a5\u8f93\u51fa\u5185\u5bb9\n    return 0;\n}\n</code></pre> <p>\u6ce8\u610f<code>scanf</code>\u548c<code>printf</code>\u662fC\u8bed\u8a00\u4e2d\u7684\u8f93\u5165\u548c\u8f93\u51fa</p> <ul> <li><code>scanf</code> \u5bf9\u5e94 <code>cin</code>\uff0c\u53d8\u91cf\u524d\u9762\u9700\u8981\u52a0 <code>&amp;</code>\u7b26\u53f7</li> <li><code>printf</code> \u5bf9\u5e94 <code>cout</code></li> </ul>"},{"location":"%E5%9F%BA%E7%A1%80%E7%AE%97%E6%B3%951/%E6%A0%BC%E5%BC%8F%E5%8C%96%E8%BE%93%E5%85%A5%E8%BE%93%E5%87%BA/#_3","title":"\u7c7b\u578b\u6807\u8bc6\u7b26","text":"<p>\u7c7b\u578b\u6807\u8bc6\u7b26\u7684\u4f5c\u7528\u662f\u5c06\u8981\u8f93\u5165\u7684\u503c\u6309\u7167\u6307\u5b9a\u7684\u683c\u5f0f\u8f93\u5165</p> <pre><code>int n;\nscanf(\"%d\",&amp;n);// \u660e\u786e\u8f93\u5165\u7684\u5185\u5bb9\u4f1a\u662f\u4e00\u4e2a\u6574\u6570\nprintf(\"%d\",n);\n</code></pre> \u6570\u636e\u7c7b\u578b \u683c\u5f0f\u7b26 <code>int</code> <code>%d</code> <code>float</code> <code>%f</code> <code>double</code> <code>%lf</code> <code>char</code> <code>%c</code> <code>char[]</code> <code>%s</code> <p>\u2728\u9700\u8981\u6ce8\u610f\u7684\u662f\uff0c\u5b57\u7b26\u6570\u7ec4\u7684\u8f93\u5165\u548c\u8f93\u51fa\u65b9\u5f0f\u6bd4\u8f83\u7279\u522b</p> <ul> <li>\u8f93\u5165\u65f6\u53ea\u9700\u8981\u5199\u6570\u7ec4\u540d,\u4e0d\u9700\u8981\u5199 &amp;</li> <li>\u8f93\u51fa\u65f6\u4e5f\u53ea\u9700\u8981\u5199\u6570\u7ec4\u540d\uff0c\u5c31\u80fd\u628a\u6574\u4e2a\u5b57\u7b26\u6570\u7ec4\u8f93\u51fa</li> </ul> <pre><code>char str[105];\nscanf(\"%s\",str);\nprintf(\"%s\",str);\n</code></pre>"},{"location":"%E5%9F%BA%E7%A1%80%E7%AE%97%E6%B3%951/%E6%A0%BC%E5%BC%8F%E5%8C%96%E8%BE%93%E5%85%A5%E8%BE%93%E5%87%BA/#_4","title":"\u683c\u5f0f\u63a7\u5236\u7b26","text":"<p>printf\u7684%d\u683c\u5f0f\u7b26\u5e94\u7528\uff1a</p> %d\u683c\u5f0f\u7b26 \u8bf4\u660e %md \u53f3\u5bf9\u9f50\u8f93\u51fam\u4f4d %-md \u5de6\u5bf9\u9f50\u8f93\u51fam\u4f4d %0md \u4f4d\u6570\u4e0d\u8db3m\u4f4d\u65f6\u88650 <p>printf\u7684%f\u683c\u5f0f\u7b26\u5e94\u7528\uff1a</p> %f\u683c\u5f0f\u7b26 \u8bf4\u660e %m.nf \u603b\u4f4d\u6570m\uff08\u542b\u5c0f\u6570\u70b9\uff09\uff0cn\u4f4d\u5c0f\u6570\uff0c\u53f3\u5bf9\u9f50 %0m.nf \u603b\u4f4d\u6570m\uff08\u542b\u5c0f\u6570\u70b9\uff09\uff0cn\u4f4d\u5c0f\u6570\uff0c\u53f3\u5bf9\u9f50\uff0c\u4f4d\u6570\u4e0d\u8db3m\u4f4d\u65f6\u88650 %-m.nf \u603b\u4f4d\u6570m\uff08\u542b\u5c0f\u6570\u70b9\uff09\uff0cn\u4f4d\u5c0f\u6570\uff0c\u5de6\u5bf9\u9f50 %.nf\uff08\u6700\u5e38\u7528\uff09 \u8f93\u51fa\u4fdd\u7559 n \u4f4d\u5c0f\u6570\uff1b <pre><code>#include&lt;bits/stdc++.h&gt;\nusing namespace std;\nint main()\n{\n    int a=12;\n    printf(\"%d\\n\",a);    //12\n\n    float b=3.1415;\n    printf(\"%3.2f\\n\",b); //3.14\n\n    char c='A';\n    printf(\"%c\\n\",c);    //A\n\n    double d=3.1415;\n    printf(\"%.3lf\\n\",d); //3.142\n    return 0;\n}\n</code></pre>"},{"location":"%E5%9F%BA%E7%A1%80%E7%AE%97%E6%B3%951/%E6%A0%BC%E5%BC%8F%E5%8C%96%E8%BE%93%E5%85%A5%E8%BE%93%E5%87%BA/#_5","title":"\u533a\u522b","text":"<p>\u4e24\u8005\u4e0d\u662f\u201c\u4e8c\u9009\u4e00\u201d\uff0c\u800c\u662f\u201c\u6309\u9700\u4f7f\u7528\u201d\u3002</p> <ol> <li><code>cin/cout</code>\u5c5e\u4e8eC++ \u7684<code>iostream</code>\u5e93\uff0c<code>scanf/printf</code>\u6e90\u81eaC\u8bed\u8a00<code>stdio.h</code>\u5e93</li> <li>cin \u6548\u7387\u6bd4 scanf \u4f4e\u5f88\u591a\uff0c\u5c24\u5176\u8f93\u5165\u6570\u636e\u8fbe\u5230 20 \u4e07\u4ee5\u4e0a\u65f6\u975e\u5e38\u660e\u663e\uff0c\u5728 100 \u4e07\u65f6 cin \u8bfb\u5165\u5c31\u4f1a\u8d85\u65f6\uff0c\u4e5f\u63a8\u8350\u7528 <code>'\\n'</code>\u53bb\u66ff\u4ee3<code>endl</code>\u3002</li> <li>cin \u3001 cout \u80fd\u591f\u81ea\u52a8\u8bc6\u522b\u53d8\u91cf\u7684\u6570\u636e\u7c7b\u578b\uff0c scanf\u3001printf \u5728\u8f93\u5165\u8f93\u51fa\u65f6\u9700\u8981\u6307\u5b9a\u6570\u636e\u7c7b\u578b\u3002scanf/printf\u548ccin/cout\u7684\u533a\u522b\u3002</li> </ol> <p><code>cin/cout</code>\u7684\u4f18\u52bf\u662f\u7b80\u5355\u6613\u7528\uff0c<code>scanf</code>/<code>printf</code>\u7684\u4f18\u52bf\u662f\u9ad8\u6027\u80fd\u3001\u683c\u5f0f\u63a7\u5236\u7075\u6d3b</p>"},{"location":"%E8%AF%AD%E6%B3%95%E8%BF%9B%E9%98%B6/","title":"\u8bed\u6cd5\u8fdb\u9636\u7b80\u4ecb","text":"<p>\u8fd9\u91cc\u5b58\u653e\u5468\u4e94\u4e0b\u5348\u8bed\u6cd5\u8fdb\u9636\u73ed\u7684\u540c\u5b66\u4eec\u7684\u7b14\u8bb0</p>"},{"location":"%E8%AF%AD%E6%B3%95%E8%BF%9B%E9%98%B6/%E5%AD%97%E7%AC%A6/","title":"\u5b57\u7b26","text":""},{"location":"%E8%AF%AD%E6%B3%95%E8%BF%9B%E9%98%B6/%E5%AD%97%E7%AC%A6/#_2","title":"\u57fa\u672c\u7528\u6cd5","text":"<p>\u5b57\u7b26\u7c7b\u578b <code>char</code></p> <p>\u5e38\u91cf\u7528\u5355\u5f15\u53f7\u62ec\u8d77\u6765\uff0c\u53cc\u5f15\u53f7\uff1a\u5b57\u7b26\u4e32</p> <p>ASCII\u7f16\u7801\uff08\u7f8e\u56fd\u4fe1\u606f\u4ea4\u6362\u6807\u51c6\u4ee3\u7801\uff09128\u4e2a\u5b57\u7b26</p> <pre><code>char d = '/n'; cout&lt;&lt;d; &lt;-\u6362\u884c\n</code></pre> <p>\u5f00\u5934\u5b57\u7b26\uff1a\u246048 =&gt;0 \u246165=&gt;A \u246297=&gt;a            \u6574\u6570-&gt;\u5b57\u7b26 <code>cout&lt;&lt;(char)a</code></p> <p><code>a = getchar();</code> &lt;= \u8f93\u5165 <code>putchar(a)</code> &lt;= \u8f93\u51fa         \u533a\u522b:\u4f1a\u8bfb\u5165\u7a7a\u683c(cin\u4e0d\u4f1a)</p> <p>\u8f6c\u4e49\u5b57\u7b26\uff1a\uff08\u7279\u6b8a\u542b\u4e49-&gt;\u666e\u901a\u8f93\u51fa\uff09 -&gt; <code>\\</code>  \u5982 <code>\\0</code>\u3001<code>\\t</code></p>"},{"location":"%E8%AF%AD%E6%B3%95%E8%BF%9B%E9%98%B6/%E5%AD%97%E7%AC%A6/#_3","title":"\u4f5c\u8005\u624b\u7a3f","text":"<p>\u4f5c\u8005: \u9648\u5f67</p> <p>\u65e5\u671f: 2025-10-31</p>"},{"location":"%E8%AF%AD%E6%B3%95%E8%BF%9B%E9%98%B6/%E5%AD%97%E7%AC%A6%E6%95%B0%E7%BB%84/","title":"\u5b57\u7b26\u6570\u7ec4","text":""},{"location":"%E8%AF%AD%E6%B3%95%E8%BF%9B%E9%98%B6/%E5%AD%97%E7%AC%A6%E6%95%B0%E7%BB%84/#_2","title":"\u9ea6\u8001\u5e08","text":"<p>\u5b57\u7b26\u6570\u7ec4\uff0c\u5c31\u662f\u5b57\u7b26+\u6570\u7ec4</p>"},{"location":"%E8%AF%AD%E6%B3%95%E8%BF%9B%E9%98%B6/%E5%AD%97%E7%AC%A6%E6%95%B0%E7%BB%84/#_3","title":"\u5b9a\u4e49\u683c\u5f0f","text":"<pre><code>char a[100];\n</code></pre> <p>\u521b\u5efa\u4e86\u4e00\u4e2a\u7c7b\u578b\u4e3a <code>char</code>\u7684\u4e00\u7ef4\u6570\u7ec4</p>"},{"location":"%E8%AF%AD%E6%B3%95%E8%BF%9B%E9%98%B6/%E5%AD%97%E7%AC%A6%E6%95%B0%E7%BB%84/#_4","title":"\u521d\u59cb\u5316","text":"<p>\u65b9\u5f0f\u4e00\uff0c\u5728\u5927\u62ec\u53f7\u91cc\u4f9d\u6b21\u586b\u5199</p> <pre><code>char a[5] = {'a','b','c'}\n</code></pre> <p>\u6ca1\u6709\u521d\u59cb\u5316\u7684\u5b57\u7b26\uff0c\u9ed8\u8ba4\u53d8\u6210\u6574\u65700\uff0c\u6574\u65700\u5728ascii\u7801\u8868\u91cc\u5bf9\u5e94\u7684\u662f<code>'\\0'</code>\uff0c\u4e5f\u5c31\u662f\u7a7a\u5b57\u7b26</p> <p>\u65b9\u5f0f\u4e8c\uff0c\u4f7f\u7528\u5b57\u7b26\u4e32\u521d\u59cb\u5316</p> <pre><code>char a[5] = \"abc\"\n</code></pre> <p>\u8fd9\u79cd\u65b9\u5f0f\u4f1a\u9ed8\u8ba4\u5728\u672b\u5c3e\u591a\u52a0\u4e00\u4e2a <code>'0'</code>\uff0c\u9700\u8981\u6ce8\u610f\u7a7a\u95f4\u5927\u5c0f\u662f\u5426\u8db3\u591f</p>"},{"location":"%E8%AF%AD%E6%B3%95%E8%BF%9B%E9%98%B6/%E5%AD%97%E7%AC%A6%E6%95%B0%E7%BB%84/#_5","title":"\u5b57\u7b26\u6570\u7ec4\u7684\u8f93\u5165\u65b9\u5f0f","text":"<p>\u65b9\u5f0f\u4e00\uff0c\u4f7f\u7528for\u5faa\u73af\u4e00\u4e2a\u4e2a\u8f93\u5165\uff08\u4e0d\u5e38\u7528\uff09</p> <pre><code>char a[105];\nint n;\ncin&gt;&gt;n;// \u5982\u679c\u9898\u76ee\u544a\u8bc9\u4f60\u957f\u5ea6\u4e3an\nfor(int i=1;i&lt;=n;i++){\n    cin&gt;&gt;a[i];\n}\n</code></pre> <p>\u65b9\u5f0f\u4e8c\uff0c\u4f7f\u7528cin\u4e00\u6b21\u6027\u8f93\u5165\uff08\u5e38\u7528\uff09</p> <pre><code>char a[105];\ncin&gt;&gt;a;\n</code></pre> <p>cin\u7684\u540e\u9762\u53ea\u9700\u8981\u5199\u4e00\u4e2a\u6570\u7ec4\u540d\uff0c\u5c31\u53ef\u4ee5\u628a\u5b8c\u6574\u7684\u5b57\u7b26\u4e32\u8bfb\u5165</p> <p>\u65b9\u5f0f\u4e09\uff0c\u4f7f\u7528cin.getline\uff08\u8f93\u5165\u5e26\u7a7a\u683c\u7684\u5b57\u7b26\u6570\u7ec4\uff09</p> <p>\u683c\u5f0f\uff1acin.getline(\u6570\u7ec4\u540d\uff0c\u6570\u7ec4\u957f\u5ea6)</p> <pre><code>char a[105];\ncin.getline(a,105);// \u4e0e\u6570\u7ec4\u5b9a\u4e49\u4fdd\u6301\u4e00\u76f4\n</code></pre>"},{"location":"%E8%AF%AD%E6%B3%95%E8%BF%9B%E9%98%B6/%E5%AD%97%E7%AC%A6%E6%95%B0%E7%BB%84/#_6","title":"\u6ce8\u610f\u70b9\ud83c\udf88","text":"<p>\u4f7f\u7528cin\u548ccin.getline\u8f93\u5165\u7684\u5b57\u7b26\u6570\u7ec4\uff0c\u4e0b\u6807\u9ed8\u8ba4\u4ece0\u5f00\u59cb</p>"},{"location":"%E8%AF%AD%E6%B3%95%E8%BF%9B%E9%98%B6/%E5%AD%97%E7%AC%A6%E6%95%B0%E7%BB%84/#_7","title":"\u8f93\u51fa","text":"<p>\u65b9\u5f0f\u4e00\uff0c\u4f7f\u7528for\u5faa\u73af\uff08\u4e0d\u5e38\u7528\uff09</p> <p>\u65b9\u5f0f\u4e8c\uff0ccout\u540e\u9762\u7d27\u8ddf\u6570\u7ec4\u540d</p> <pre><code>char a[105];\ncin&gt;&gt;a;\ncout&lt;&lt;a;\n</code></pre>"},{"location":"%E8%AF%AD%E6%B3%95%E8%BF%9B%E9%98%B6/%E5%AD%97%E7%AC%A6%E6%95%B0%E7%BB%84/#_8","title":"\u5e38\u7528\u51fd\u6570","text":"\u51fd\u6570 \u529f\u80fd \u8303\u4f8b \u6c42\u5b57\u7b26\u4e32\u957f\u5ea6\u51fd\u6570 strlen(s) \u8fd4\u56de\u5b57\u7b26\u4e32\u7684\u957f\u5ea6\uff08\u5373\u7ed3\u675f\u7b26\u4e4b\u524d\u7684\u5b57\u7b26\u6570\u76ee\uff09 char a[10]=\"hello\"; int len=strlen(a); //len \u4e3a 5 \u5b57\u7b26\u4e32\u6bd4\u8f83\u51fd\u6570 strcmp(s1,s2) \u6bd4\u8f83\u5b57\u7b26\u4e32 s1 \u548c s2\uff0c\u5982\u679c\u76f8\u7b49\u8fd4\u56de 0\uff1b\u5982\u679c s1s2\uff0c\u8fd4\u56de\u6b63\u6570 char a[10]=\"hello\"\uff0cb[10]=\"world\"; int c=strcmp(a,b); //\u6b64\u65f6 c \u7684\u503c\u4e3a\u8d1f\u6570 \u5b57\u7b26\u4e32\u62fc\u63a5\u51fd\u6570 strcat(s1,s2) \u51fd\u6570\u5c06\u5b57\u7b26\u4e32 s2 \u8fde\u63a5\u5230 s1 \u7684\u672b\u7aef\uff0c\u5e76\u8fd4\u56de s1 \u7684\u5730\u5740 char a[20]=\"hello\"\uff0cb[10]=\"world\"; strcat(a,b); cout&lt;&lt;a; //\u6b64\u65f6 a \u5b57\u7b26\u6570\u7ec4\u4e2d\u5b58\u653e helloworld \u67e5\u627e\u5b50\u4e32\u51fd\u6570 strstr(s1,s2) \u8fd4\u56de\u5b57\u7b26\u4e32 a \u4e2d\u9996\u6b21\u51fa\u73b0\u5b50\u4e32 b \u7684\u5730\u5740\uff0c\u5982\u679c\u672a\u627e\u5230\u5219\u8fd4\u56de NULL char a[10]=\"hello\"\uff0cb[10]=\"el\"\uff0cc[10]=\"eo\"; cout&lt;&lt;strstr(a,b); //\u8f93\u51fa ello cout&lt;&lt;strstr(a,c); //\u8f93\u51fa NULL(\u7a7a)"},{"location":"%E8%AF%AD%E6%B3%95%E8%BF%9B%E9%98%B6/%E5%AD%97%E7%AC%A6%E6%95%B0%E7%BB%84/#_9","title":"\u9648\u5f67","text":"<p>### \u5b57\u7b26\u4e32\uff08\u5b57\u7b26\u6570\u7ec4\uff09 </p> <ul> <li>\u7531\u591a\u4e2a\u5b57\u7b26\u7ec4\u6210\uff0c\u7531\u53cc\u5f15\u53f7\u62ec\u8d77  </li> <li>\u5b9a\u4e49\u5b57\u7b26\u578b\u6570\u7ec4\uff1a<code>char a[888]</code> </li> <li>\u9ed8\u8ba4\u4e3a\u7a7a\uff08NULL\uff09=&gt; <code>0</code> [\u7528\u7684\u4e0d\u591a] \u6216 <code>char a[888] = \"abc\";</code> [\u5e38\u7528]   </li> <li>\u4f1a\u989d\u5916\u52a0\u5b57\u7b26 <code>\\0</code>\uff0c\u5f00\u591a\u4e00\u70b9\uff01\uff01\uff01   </li> <li>\u8f93\u5165\u8f93\u51fa\uff1a - <code>cin &gt;&gt; a</code>   - <code>cout &lt;&lt; a</code> </li> <li>\u5e26\u7a7a\u683c\u8f93\u5165\uff1a - <code>cin.getline</code> </li> <li>\u5927\u5c0f\u6bd4\u8f83\uff08a \u548c b\uff09\uff1a   <code>strcmp(a, b)</code> \u8fd4\u56de\u503c\uff1a   \u2460 \u8d1f\u6570 \u2192 <code>a &lt; b</code>   \u2461 0 \u2192 <code>a == b</code>   \u2462 \u6b63\u6570 \u2192 <code>a &gt; b</code></li> </ul>"},{"location":"%E8%AF%AD%E6%B3%95%E8%BF%9B%E9%98%B6/%E5%AD%97%E7%AC%A6%E6%95%B0%E7%BB%84/#_10","title":"\u674e\u4fca\u6cfd","text":"<p>\u5b57\u7b26\u4e0e\u5b57\u7b26\u4e32\u7b14\u8bb0</p> <p>\u5b57\u7b26\uff08char\uff09 - \u5b57\u7b26\u662f\u7528 <code>' '</code> \u62ec\u8d77\u6765\u7684 </p> <ul> <li> <p><code>'\\n'</code> = endl </p> </li> <li> <p><code>'0' ~ '9'</code> = 48 ~ 57 </p> </li> <li> <p><code>'A' ~ 'Z'</code> = 65 ~ 90 </p> </li> <li> <p><code>'a' ~ 'z'</code> = 97 ~ 122 ### \u8f93\u5165\u8f93\u51fa </p> </li> </ul> <pre><code>char a, b;\na = getchar();\nb = getchar();\nputchar(a);\nputchar(b);\n</code></pre> <p>\u5b57\u7b26\u4e32\u662f\u7528<code>\"\"</code>\u62ec\u8d77\u6765\u7684\uff0c\u7531\u591a\u4e2a\u5b57\u6bcd\u7ec4\u6210</p>"},{"location":"%E8%AF%AD%E6%B3%95%E8%BF%9B%E9%98%B6/%E5%AD%97%E7%AC%A6%E6%95%B0%E7%BB%84/#_11","title":"\u5b9a\u4e49","text":"<pre><code>char a[100];\n</code></pre> <p>0-&gt; <code>NULL('\\0')</code></p>"},{"location":"%E8%AF%AD%E6%B3%95%E8%BF%9B%E9%98%B6/%E5%AD%97%E7%AC%A6%E6%95%B0%E7%BB%84/#_12","title":"\u957f\u5ea6","text":"<pre><code>cout&lt;&lt;strlen(a)\n</code></pre>"},{"location":"%E8%AF%AD%E6%B3%95%E8%BF%9B%E9%98%B6/%E5%AD%97%E7%AC%A6%E6%95%B0%E7%BB%84/#_13","title":"\u8f93\u51fa","text":"<pre><code>char a[105];\ncin.getline(a,105);\ncout&lt;&lt;a;\n</code></pre>"}]}